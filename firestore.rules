rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAllowedAccount() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.email_verified == true
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'authMethod',
          'emailVerified',
          'preferredLanguage',
          'proactiveCheckins',
          'ephemeralMode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'authMethod',
          'emailVerified',
          'preferredLanguage',
          'proactiveCheckins',
          'ephemeralMode',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.authMethod in ['anonymous', 'google', 'email']
        && data.emailVerified is bool
        && data.preferredLanguage in ['en', 'bn']
        && data.proactiveCheckins is bool
        && data.ephemeralMode is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'bio',
          'avatarTone',
          'avatarInitials',
          'statusTags',
          'interests',
          'availability',
          'preferredFeedVisibility',
          'showOnlineStatus',
          'isOnline',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'bio',
          'avatarTone',
          'avatarInitials',
          'statusTags',
          'interests',
          'availability',
          'preferredFeedVisibility',
          'showOnlineStatus',
          'isOnline',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.bio is string
        && data.bio.size() <= 280
        && data.avatarTone in ['sage', 'terracotta', 'navy', 'sand']
        && data.avatarInitials is string
        && data.avatarInitials.size() >= 1
        && data.avatarInitials.size() <= 4
        && data.statusTags is list
        && data.statusTags.size() <= 18
        && (data.statusTags.size() == 0 || (data.statusTags[0] is string && data.statusTags[0].size() <= 60))
        && data.interests is list
        && data.interests.size() <= 12
        && (data.interests.size() == 0 || (data.interests[0] is string && data.interests[0].size() <= 60))
        && data.availability in ['available', 'open_to_requests', 'not_accepting', 'taking_a_break']
        && data.preferredFeedVisibility in ['community', 'private']
        && data.showOnlineStatus is bool
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemory(data, memoryId, userId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'text',
          'meta',
          'isNew',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'text',
          'meta',
          'isNew',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == memoryId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 300
        && data.meta is string
        && data.meta.size() >= 1
        && data.meta.size() <= 120
        && data.isNew is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data, entryId, userId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'dateLabel',
          'relativeTimeLabel',
          'title',
          'body',
          'mood',
          'tags',
          'aiLocked',
          'updatedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'dateLabel',
          'banglaDateLabel',
          'relativeTimeLabel',
          'title',
          'body',
          'mood',
          'tags',
          'aiLocked',
          'updatedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == entryId
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 60
        && (!('banglaDateLabel' in data) || (data.banglaDateLabel is string && data.banglaDateLabel.size() <= 60))
        && data.relativeTimeLabel is string
        && data.relativeTimeLabel.size() >= 1
        && data.relativeTimeLabel.size() <= 60
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 180
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 8000
        && data.mood in ['Calm', 'Heavy', 'Hopeful', 'Restless']
        && data.tags is list
        && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.aiLocked is bool
        && data.updatedAtLabel is string
        && data.updatedAtLabel.size() >= 1
        && data.updatedAtLabel.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserBlock(data, userId, targetUid) {
      return data.keys().hasAll(['blockerUid', 'targetUid', 'targetName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['blockerUid', 'targetUid', 'targetName', 'createdAt', 'updatedAt'])
        && isValidId(data.blockerUid)
        && data.blockerUid == request.auth.uid
        && data.blockerUid == userId
        && isValidId(data.targetUid)
        && data.targetUid == targetUid
        && data.targetUid != data.blockerUid
        && data.targetName is string
        && data.targetName.size() >= 1
        && data.targetName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, userId, notifId) {
      return data.keys().hasAll(['id', 'recipientUid', 'senderUid', 'type', 'title', 'body', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'recipientUid', 'senderUid', 'type', 'title', 'body', 'relatedId', 'read', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == notifId
        && isValidId(data.recipientUid)
        && data.recipientUid == userId
        && isValidId(data.senderUid)
        && data.type in ['peer_request', 'request_accepted', 'request_declined', 'peer_message', 'feed_support']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 280
        && (!('relatedId' in data) || (data.relatedId is string && data.relatedId.size() <= 128))
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeerRequest(data, requestId) {
      return data.keys().hasAll([
          'id',
          'senderUid',
          'senderName',
          'senderAvatarTone',
          'senderTags',
          'recipientUid',
          'recipientName',
          'recipientAvatarTone',
          'recipientTags',
          'status',
          'introMessage',
          'sharedContextSummary',
          'ignoredByRecipient',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'senderUid',
          'senderName',
          'senderAvatarTone',
          'senderTags',
          'recipientUid',
          'recipientName',
          'recipientAvatarTone',
          'recipientTags',
          'status',
          'introMessage',
          'sharedContextSummary',
          'ignoredByRecipient',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == requestId
        && isValidId(data.senderUid)
        && isValidId(data.recipientUid)
        && data.senderUid != data.recipientUid
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 80
        && data.senderAvatarTone in ['sage', 'terracotta', 'navy', 'sand']
        && data.recipientAvatarTone in ['sage', 'terracotta', 'navy', 'sand']
        && data.senderTags is list && data.senderTags.size() <= 18
        && data.recipientTags is list && data.recipientTags.size() <= 18
        && data.status in ['pending', 'accepted', 'declined', 'cancelled', 'blocked']
        && data.introMessage is string && data.introMessage.size() <= 500
        && data.sharedContextSummary is string && data.sharedContextSummary.size() <= 200
        && data.ignoredByRecipient is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeerConversation(data, conversationId) {
      return data.keys().hasAll([
          'id',
          'participantUids',
          'participantNames',
          'participantTones',
          'requestId',
          'status',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'participantUids',
          'participantNames',
          'participantTones',
          'requestId',
          'status',
          'endedByUid',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == conversationId
        && data.participantUids is list
        && data.participantUids.size() == 2
        && isValidId(data.participantUids[0])
        && isValidId(data.participantUids[1])
        && data.participantNames is map
        && data.participantTones is map
        && isValidId(data.requestId)
        && data.status in ['active', 'ended']
        && (!('endedByUid' in data) || isValidId(data.endedByUid))
        && data.lastMessagePreview is string
        && data.lastMessagePreview.size() <= 180
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeerMessage(data, conversationId, messageId) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'participantUids',
          'senderUid',
          'senderName',
          'text',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'conversationId',
          'participantUids',
          'senderUid',
          'senderName',
          'text',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == messageId
        && isValidId(data.conversationId)
        && data.conversationId == conversationId
        && data.participantUids is list
        && data.participantUids.size() == 2
        && isValidId(data.senderUid)
        && data.senderUid == request.auth.uid
        && data.senderUid in data.participantUids
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedPost(data, postId) {
      return data.keys().hasAll([
          'id',
          'authorUid',
          'authorName',
          'authorAvatarTone',
          'postType',
          'body',
          'tags',
          'visibility',
          'reactionCounts',
          'commentCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'authorUid',
          'authorName',
          'authorAvatarTone',
          'postType',
          'mood',
          'title',
          'body',
          'tags',
          'visibility',
          'reactionCounts',
          'commentCount',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == postId
        && isValidId(data.authorUid)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorAvatarTone in ['sage', 'terracotta', 'navy', 'sand']
        && data.postType in ['mood', 'thought', 'story', 'study_life']
        && (!('mood' in data) || (data.mood is string && data.mood.size() <= 40))
        && (!('title' in data) || (data.title is string && data.title.size() <= 160))
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 4000
        && data.tags is list && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 60))
        && data.visibility in ['community', 'private']
        && data.reactionCounts is map
        && data.reactionCounts.keys().hasAll(['hear_you', 'sending_support', 'relatable', 'you_got_this'])
        && data.reactionCounts.keys().hasOnly(['hear_you', 'sending_support', 'relatable', 'you_got_this'])
        && data.reactionCounts.hear_you is number && data.reactionCounts.hear_you >= 0
        && data.reactionCounts.sending_support is number && data.reactionCounts.sending_support >= 0
        && data.reactionCounts.relatable is number && data.reactionCounts.relatable >= 0
        && data.reactionCounts.you_got_this is number && data.reactionCounts.you_got_this >= 0
        && data.commentCount is number && data.commentCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedReaction(data, postId, userId) {
      return data.keys().hasAll(['userId', 'postId', 'reactionType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'postId', 'reactionType', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.userId == userId
        && isValidId(data.postId)
        && data.postId == postId
        && data.reactionType in ['hear_you', 'sending_support', 'relatable', 'you_got_this']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedComment(data, postId, commentId) {
      return data.keys().hasAll(['id', 'postId', 'authorUid', 'authorName', 'body', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'postId', 'authorUid', 'authorName', 'body', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == commentId
        && isValidId(data.postId)
        && data.postId == postId
        && isValidId(data.authorUid)
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModerationReport(data, reportId) {
      return data.keys().hasAll(['id', 'reporterUid', 'targetType', 'targetId', 'reason', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'reporterUid', 'targetType', 'targetId', 'targetUid', 'reason', 'details', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id == reportId
        && isValidId(data.reporterUid)
        && data.reporterUid == request.auth.uid
        && data.targetType in ['user', 'post', 'comment', 'conversation']
        && isValidId(data.targetId)
        && (!('targetUid' in data) || isValidId(data.targetUid))
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 120
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Boot connectivity check doc
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }

    // Private User Sanctuary Profile (strictly owner-isolated, no list)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'authMethod',
            'emailVerified',
            'preferredLanguage',
            'proactiveCheckins',
            'ephemeralMode',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      // Approved Companion Memories Subcollection
      match /memories/{memoryId} {
        allow get: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidMemory(incoming(), memoryId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidMemory(incoming(), memoryId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'meta', 'isNew', 'updatedAt']);

        allow delete: if isValidId(userId)
          && isValidId(memoryId)
          && isOwner(userId)
          && isAllowedAccount();
      }

      // Encrypted Personal Journal Subcollection
      match /journal/{entryId} {
        allow get: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidJournalEntry(incoming(), entryId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidJournalEntry(incoming(), entryId, userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateLabel',
            'banglaDateLabel',
            'relativeTimeLabel',
            'title',
            'body',
            'mood',
            'tags',
            'aiLocked',
            'updatedAtLabel',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isAllowedAccount();
      }

      // Blocked Users Subcollection
      match /blocks/{targetUid} {
        allow get: if isValidId(userId)
          && isValidId(targetUid)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.blockerUid == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(targetUid)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidUserBlock(incoming(), userId, targetUid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if false;

        allow delete: if isValidId(userId)
          && isValidId(targetUid)
          && isOwner(userId)
          && isAllowedAccount();
      }

      // In-App Notifications Subcollection
      match /notifications/{notifId} {
        allow get: if isValidId(userId)
          && isValidId(notifId)
          && isOwner(userId)
          && isAllowedAccount();

        allow list: if isOwner(userId)
          && isAllowedAccount()
          && resource.data.recipientUid == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(notifId)
          && isSignedIn()
          && isAllowedAccount()
          && isValidNotification(incoming(), userId, notifId)
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(notifId)
          && isOwner(userId)
          && isAllowedAccount()
          && isValidNotification(incoming(), userId, notifId)
          && incoming().id == existing().id
          && incoming().recipientUid == existing().recipientUid
          && incoming().senderUid == existing().senderUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

        allow delete: if isValidId(userId)
          && isValidId(notifId)
          && isOwner(userId)
          && isAllowedAccount();
      }
    }

    // Zero-PII Public Discoverable Peer Profiles
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && isAllowedAccount();

      allow list: if isSignedIn()
        && isAllowedAccount()
        && resource.data.uid is string;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isAllowedAccount()
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'bio',
          'avatarTone',
          'avatarInitials',
          'statusTags',
          'interests',
          'availability',
          'preferredFeedVisibility',
          'showOnlineStatus',
          'isOnline',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId) && isAllowedAccount();
    }

    // Peer Conversation Requests
    match /peerRequests/{requestId} {
      allow get: if isValidId(requestId)
        && isSignedIn()
        && isAllowedAccount()
        && (existing().senderUid == request.auth.uid || existing().recipientUid == request.auth.uid);

      allow list: if isSignedIn()
        && isAllowedAccount()
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);

      allow create: if isValidId(requestId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidPeerRequest(incoming(), requestId)
        && incoming().senderUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().ignoredByRecipient == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidPeerRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().senderUid == existing().senderUid
        && incoming().recipientUid == existing().recipientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'pending'
        && (
          (
            request.auth.uid == existing().senderUid
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            request.auth.uid == existing().recipientUid
            && incoming().status in ['accepted', 'declined', 'blocked']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            request.auth.uid == existing().recipientUid
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['ignoredByRecipient', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Active Peer Conversations (Created only after an accepted request)
    match /peerConversations/{conversationId} {
      allow get: if isValidId(conversationId)
        && isSignedIn()
        && isAllowedAccount()
        && request.auth.uid in existing().participantUids;

      allow list: if isSignedIn()
        && isAllowedAccount()
        && request.auth.uid in resource.data.participantUids;

      allow create: if isValidId(conversationId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidPeerConversation(incoming(), conversationId)
        && request.auth.uid in incoming().participantUids
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/peerRequests/$(incoming().requestId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/peerRequests/$(incoming().requestId)).data.recipientUid == request.auth.uid
        && get(/databases/$(database)/documents/peerRequests/$(incoming().requestId)).data.senderUid in incoming().participantUids
        && get(/databases/$(database)/documents/peerRequests/$(incoming().requestId)).data.recipientUid in incoming().participantUids;

      allow update: if isValidId(conversationId)
        && isSignedIn()
        && isAllowedAccount()
        && request.auth.uid in existing().participantUids
        && isValidPeerConversation(incoming(), conversationId)
        && incoming().id == existing().id
        && incoming().participantUids == existing().participantUids
        && incoming().requestId == existing().requestId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'active'
        && (
          (
            incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'updatedAt'])
          ) || (
            incoming().status == 'ended'
            && incoming().endedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedByUid', 'updatedAt'])
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(conversationId)
          && isValidId(messageId)
          && isSignedIn()
          && isAllowedAccount()
          && request.auth.uid in existing().participantUids;

        allow list: if isSignedIn()
          && isAllowedAccount()
          && request.auth.uid in resource.data.participantUids;

        allow create: if isValidId(conversationId)
          && isValidId(messageId)
          && isSignedIn()
          && isAllowedAccount()
          && isValidPeerMessage(incoming(), conversationId, messageId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && request.auth.uid in get(/databases/$(database)/documents/peerConversations/$(conversationId)).data.participantUids
          && get(/databases/$(database)/documents/peerConversations/$(conversationId)).data.status == 'active';

        allow update, delete: if false;
      }
    }

    // SHONGI Community & Private Reflection Feed
    match /feedPosts/{postId} {
      allow get: if isValidId(postId)
        && isSignedIn()
        && isAllowedAccount()
        && (existing().visibility == 'community' || existing().authorUid == request.auth.uid);

      allow list: if isSignedIn()
        && isAllowedAccount()
        && (resource.data.visibility == 'community' || resource.data.authorUid == request.auth.uid);

      allow create: if isValidId(postId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidFeedPost(incoming(), postId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(postId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidFeedPost(incoming(), postId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            request.auth.uid == existing().authorUid
            && incoming().diff(existing()).affectedKeys().hasOnly(['postType', 'mood', 'title', 'body', 'tags', 'visibility', 'updatedAt'])
          ) || (
            existing().visibility == 'community'
            && incoming().diff(existing()).affectedKeys().hasOnly(['reactionCounts', 'commentCount', 'updatedAt'])
          )
        );

      allow delete: if isValidId(postId)
        && isSignedIn()
        && isAllowedAccount()
        && existing().authorUid == request.auth.uid;

      match /reactions/{reactorUid} {
        allow get: if isValidId(postId)
          && isValidId(reactorUid)
          && isSignedIn()
          && isAllowedAccount();

        allow list: if isSignedIn()
          && isAllowedAccount()
          && resource.data.postId == postId;

        allow create: if isValidId(postId)
          && isValidId(reactorUid)
          && isOwner(reactorUid)
          && isAllowedAccount()
          && isValidFeedReaction(incoming(), postId, reactorUid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            get(/databases/$(database)/documents/feedPosts/$(postId)).data.visibility == 'community'
            || get(/databases/$(database)/documents/feedPosts/$(postId)).data.authorUid == request.auth.uid
          );

        allow update: if isValidId(postId)
          && isValidId(reactorUid)
          && isOwner(reactorUid)
          && isAllowedAccount()
          && isValidFeedReaction(incoming(), postId, reactorUid)
          && incoming().userId == existing().userId
          && incoming().postId == existing().postId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['reactionType', 'updatedAt']);

        allow delete: if isValidId(postId)
          && isValidId(reactorUid)
          && isOwner(reactorUid)
          && isAllowedAccount();
      }

      match /comments/{commentId} {
        allow get: if isValidId(postId)
          && isValidId(commentId)
          && isSignedIn()
          && isAllowedAccount();

        allow list: if isSignedIn()
          && isAllowedAccount()
          && resource.data.postId == postId;

        allow create: if isValidId(postId)
          && isValidId(commentId)
          && isSignedIn()
          && isAllowedAccount()
          && isValidFeedComment(incoming(), postId, commentId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            get(/databases/$(database)/documents/feedPosts/$(postId)).data.visibility == 'community'
            || get(/databases/$(database)/documents/feedPosts/$(postId)).data.authorUid == request.auth.uid
          );

        allow update: if false;

        allow delete: if isValidId(postId)
          && isValidId(commentId)
          && isSignedIn()
          && isAllowedAccount()
          && existing().authorUid == request.auth.uid;
      }
    }

    // Confidential Moderation Reports
    match /moderationReports/{reportId} {
      allow get: if isValidId(reportId)
        && isSignedIn()
        && isAllowedAccount()
        && existing().reporterUid == request.auth.uid;

      allow list: if isSignedIn()
        && isAllowedAccount()
        && resource.data.reporterUid == request.auth.uid;

      allow create: if isValidId(reportId)
        && isSignedIn()
        && isAllowedAccount()
        && isValidModerationReport(incoming(), reportId)
        && incoming().reporterUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update, delete: if false;
    }
  }
}
