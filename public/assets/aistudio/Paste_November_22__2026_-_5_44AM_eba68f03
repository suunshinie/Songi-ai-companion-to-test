<script>
  function insertPrompt(text) {
    const editor = document.getElementById('journal-editor');
    if (!editor) return;
    const currentVal = editor.value.trim();
    const promptAddition = "\n\n[Reflective Prompt: " + text + "]\n";
    editor.value = currentVal + promptAddition;
    editor.focus();
    editor.selectionStart = editor.value.length;
    editor.selectionEnd = editor.value.length;
    
    // Quick visual cue on autosave status
    const status = document.getElementById('save-status');
    if (status) {
      status.innerText = "Draft updated just now";
      setTimeout(() => {
        const now = new Date();
        const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        status.innerText = "Saved locally at " + timeStr + " (On-device DB)";
      }, 1500);
    }
  }

  // Micro interaction for Save button
  document.getElementById('btn-save')?.addEventListener('click', function() {
    const btn = this;
    const originalText = btn.innerHTML;
    btn.innerHTML = `<span class="material-symbols-outlined text-lg animate-spin">refresh</span> <span>Encrypting...</span>`;
    setTimeout(() => {
      btn.innerHTML = `<span class="material-symbols-outlined text-lg">done_all</span> <span>Encrypted & Stored</span>`;
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 1800);
    }, 450);
  });

  // Micro interaction for Passcode confirmation
  document.getElementById('btn-passcode')?.addEventListener('click', function() {
    alert("Passcode Lock Active: Your journal partition is secured with your master device key. Biometric authentication enabled.");
  });

  // Micro interaction for Export Encrypted Backup
  document.getElementById('btn-export')?.addEventListener('click', function() {
    const now = new Date().toISOString().slice(0, 10);
    alert(`Encrypted backup file "shongi-vault-${now}.shg" generated with AES-GCM 256. Stored in local download directory.`);
  });

  // Soft confirmation for delete action
  document.getElementById('btn-delete')?.addEventListener('click', function() {
    if (confirm("Are you sure you want to permanently erase this entry from the local SQLite store? This action cannot be undone.")) {
      const editor = document.getElementById('journal-editor');
      if (editor) editor.value = "";
      const status = document.getElementById('save-status');
      if (status) status.innerText = "Entry cleared permanently from device storage";
    }
  });
