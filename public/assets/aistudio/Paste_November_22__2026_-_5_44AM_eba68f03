            </p>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant mt-1.5 pl-1">${timeStr} • Companion Safe</span>
        </div>
      `;
      thread.appendChild(companionBubble);
      companionBubble.scrollIntoView({ behavior: 'smooth' });
    }, 600);
  }

  function escapeHtml(string) {
    return String(string).replace(/[&<>"']/g, function(s) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[s];
    });
  }

  function clearCurrentSession() {
    if (confirm("Are you sure you want to purge the current dialogue thread from local view? This cannot be undone.")) {
      const thread = document.getElementById('chat-thread');
      thread.innerHTML = `
        <div class="flex items-center justify-center gap-4 py-8">
