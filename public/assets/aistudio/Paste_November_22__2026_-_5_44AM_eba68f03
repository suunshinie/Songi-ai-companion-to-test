<!-- Interactive 4-7-8 Breathing Engine Script -->
<script>
    (function initBreathingRhythm() {
      const breathRing = document.getElementById('breathRing');
      const breathSubRing = document.getElementById('breathSubRing');
      const breathCore = document.getElementById('breathCore');
      const breathAction = document.getElementById('breathAction');
      const breathTimer = document.getElementById('breathTimer');
      const toggleBtn = document.getElementById('toggleBreathBtn');
      const breathBtnIcon = document.getElementById('breathBtnIcon');
      const breathBtnText = document.getElementById('breathBtnText');
      const resetBtn = document.getElementById('resetBreathBtn');

      if (!breathRing || !breathCore) return;

      let isRunning = true;
      let phaseIndex = 0; // 0: Inhale (4s), 1: Hold (7s), 2: Exhale (8s)
      let phaseTimeRemaining = 4;
      let intervalTimer = null;

      const phases = [
        { label: 'Inhale', duration: 4, scale: 'scale-125', ringScale: 'scale-150', subScale: 'scale-125' },
        { label: 'Hold', duration: 7, scale: 'scale-125', ringScale: 'scale-150', subScale: 'scale-125' },
        { label: 'Exhale', duration: 8, scale: 'scale-90', ringScale: 'scale-95', subScale: 'scale-90' }
      ];

      function applyPhaseVisuals() {
        const cur = phases[phaseIndex];
        breathAction.textContent = cur.label;
        breathTimer.textContent = phaseTimeRemaining + 's';

        // Animate scales
        breathCore.style.transform = phaseIndex === 2 ? 'scale(0.85)' : 'scale(1.2)';
        breathRing.style.transform = phaseIndex === 2 ? 'scale(0.95)' : 'scale(1.4)';
        breathSubRing.style.transform = phaseIndex === 2 ? 'scale(0.9)' : 'scale(1.25)';
      }

      function tick() {
        if (!isRunning) return;

        phaseTimeRemaining--;
        if (phaseTimeRemaining <= 0) {
          phaseIndex = (phaseIndex + 1) % phases.length;
          phaseTimeRemaining = phases[phaseIndex].duration;
        }
        applyPhaseVisuals();
      }

      intervalTimer = setInterval(tick, 1000);
      applyPhaseVisuals();

      toggleBtn.addEventListener('click', function() {
        isRunning = !isRunning;
        if (isRunning) {
          breathBtnIcon.textContent = 'pause';
          breathBtnText.textContent = 'Pause Rhythm';
        } else {
          breathBtnIcon.textContent = 'play_arrow';
          breathBtnText.textContent = 'Resume Rhythm';
        }
      });

      resetBtn.addEventListener('click', function() {
        phaseIndex = 0;
        phaseTimeRemaining = phases[0].duration;
        isRunning = true;
        breathBtnIcon.textContent = 'pause';
        breathBtnText.textContent = 'Pause Rhythm';
        applyPhaseVisuals();
      });
    })();
  </script>
