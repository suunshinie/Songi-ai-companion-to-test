  function fillIntent(text) {
    const input = document.getElementById('message-input');
    input.value = text;
    input.focus();
  }

  function approveMemory() {
    const actions = document.getElementById('memory-actions');
    const feedback = document.getElementById('memory-feedback');
    const card = document.getElementById('memory-proposal-card');
    const sideItem = document.getElementById('newly-added-memory');

    actions.classList.add('hidden');
    feedback.classList.remove('hidden');
    card.classList.add('bg-tertiary-fixed/30');

    if (sideItem) {
      sideItem.classList.remove('hidden');
    }
  }

  function dismissMemory() {
    const card = document.getElementById('memory-proposal-card');
    card.style.opacity = '0';
    card.style.transform = 'translateY(-10px)';
    setTimeout(() => {
      card.remove();
    }, 300);
  }

  function editMemoryPrompt() {
    const display = document.getElementById('memory-text-display');
    const current = display.innerText.replace(/"/g, '');
    const edited = prompt("Edit the memory to capture your exact nuance / আপনার স্মৃতিটি সংশোধন করুন:", current);
    if (edited && edited.trim() !== '') {
      display.innerText = `"${edited.trim()}"`;
    }
  }

  function toggleVoiceRecord() {
    const mic = document.getElementById('mic-btn');
    const isRecording = mic.classList.contains('bg-secondary');

    if (!isRecording) {
      mic.classList.remove('bg-surface-container', 'text-primary');
      mic.classList.add('bg-secondary', 'text-on-secondary', 'animate-pulse');
      alert("Microphone active: Speaking in Bangla/English... (Press again to stop)");
    } else {
      mic.classList.remove('bg-secondary', 'text-on-secondary', 'animate-pulse');
      mic.classList.add('bg-surface-container', 'text-primary');
    }
  }

  function sendMessage() {
    const input = document.getElementById('message-input');
    const text = input.value.trim();
    if (!text) return;

    const thread = document.getElementById('chat-thread');
    const now = new Date();
    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    const userBubble = document.createElement('div');
    userBubble.className = "flex flex-col items-end max-w-xl self-end";
    userBubble.innerHTML = `
      <div class="bg-primary-container text-on-primary rounded-2xl rounded-br-sm px-5 py-4 shadow-sm">
        <p class="font-body-lg text-body-lg text-on-primary leading-relaxed">${escapeHtml(text)}</p>
      </div>
      <span class="font-label-sm text-label-sm text-on-surface-variant mt-1.5 pr-1">${timeStr} • Delivered</span>
    `;

    thread.appendChild(userBubble);
    input.value = '';

    // Gentle response simulation
    setTimeout(() => {
      const companionBubble = document.createElement('div');
      companionBubble.className = "flex items-start gap-3.5 max-w-2xl self-start";
      companionBubble.innerHTML = `
        <div class="w-9 h-9 rounded-full bg-primary flex items-center justify-center text-on-primary flex-shrink-0 mt-1 shadow-sm">
          <span class="material-symbols-outlined text-lg">spa</span>
        </div>
        <div class="flex flex-col">
          <div class="bg-surface-container-lowest text-on-surface rounded-2xl rounded-bl-sm px-6 py-5 shadow-sm space-y-2">
            <p class="font-body-lg text-body-lg text-on-surface leading-relaxed">
