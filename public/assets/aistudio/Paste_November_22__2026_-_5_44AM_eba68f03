<script>
  (function() {
    const pills = document.querySelectorAll('.mood-pill');
    const previewText = document.getElementById('shongi-preview-text');
    const previewBangla = document.getElementById('shongi-preview-bangla');
    const heroInput = document.getElementById('shongi-hero-input');
    const defaultEn = 'Select or hover over how you feel for a gentle reflection.';
    let selectedPill = null;

    function updateState(pill, active) {
      if (!pill) {
        if (!selectedPill) {
          if (previewText) previewText.textContent = defaultEn;
          if (previewBangla) previewBangla.classList.add('hidden');
          if (heroInput) heroInput.placeholder = 'Write anything... (Bangla or English)';
        } else {
          updateState(selectedPill, true);
        }
        return;
      }

      const resp = pill.getAttribute('data-response');
      const bangla = pill.getAttribute('data-bangla');
      const mood = pill.getAttribute('data-mood');

      if (previewText && resp) previewText.textContent = resp;
      if (previewBangla && bangla) {
        previewBangla.textContent = bangla;
        previewBangla.classList.remove('hidden');
      }
      if (heroInput && active) {
        heroInput.placeholder = mood === 'talk' ? 'Type or speak whatever is on your mind...' : 'Take your time, write a thought here...';
      }
    }

    pills.forEach(pill => {
      pill.addEventListener('mouseenter', () => {
        updateState(pill, false);
      });

      pill.addEventListener('mouseleave', () => {
        updateState(null, false);
      });

      pill.addEventListener('click', () => {
        if (selectedPill === pill) {
          selectedPill.classList.remove('bg-white', 'border-[#2F6F63]', 'shadow-sm');
          selectedPill.querySelector('.mood-dot').classList.remove('bg-[#2F6F63]', 'scale-125');
          selectedPill = null;
          updateState(null, false);
        } else {
          pills.forEach(p => {
            p.classList.remove('bg-white', 'border-[#2F6F63]', 'border-[#C97B5A]', 'shadow-sm');
            const dot = p.querySelector('.mood-dot');
            if (dot) dot.classList.remove('bg-[#2F6F63]', 'bg-[#C97B5A]', 'scale-125');
          });
          selectedPill = pill;
          const isTalk = pill.getAttribute('data-mood') === 'talk';
          pill.classList.add('bg-white', isTalk ? 'border-[#C97B5A]' : 'border-[#2F6F63]', 'shadow-sm');
          const activeDot = pill.querySelector('.mood-dot');
          if (activeDot) {
            activeDot.classList.add(isTalk ? 'bg-[#C97B5A]' : 'bg-[#2F6F63]', 'scale-125');
          }
          updateState(pill, true);
        }
      });
    });
  })();
